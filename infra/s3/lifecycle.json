{
  "Rules": [
    {
      "ID": "delete-uploads-after-30d-unless-retained",
      "Status": "Enabled",
      "Filter": {
        "And": {
          "Prefix": "uploads/",
          "Tags": [
            {
              "Key": "retain",
              "Value": "false"
            }
          ]
        }
      },
      "Expiration": {
        "Days": 30
      }
    }
  ]
}
