{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QueryScanAndGetItems",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:GetItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:863518416901:table/bird-classifier-py-data",
        "arn:aws:dynamodb:us-east-1:863518416901:table/bird-classifier-py-data/index/*"
      ]
    },
    {
      "Sid": "ReadTrainingRuns",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:GetItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:863518416901:table/bird-classifier-py-training-runs",
        "arn:aws:dynamodb:us-east-1:863518416901:table/bird-classifier-py-training-runs/index/*"
      ]
    },
    {
      "Sid": "UpdateOnlyReviewFields",
      "Effect": "Allow",
      "Action": "dynamodb:UpdateItem",
      "Resource": "arn:aws:dynamodb:us-east-1:863518416901:table/bird-classifier-py-data",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:Attributes": [
            "pk",
            "sk",
            "review_status",
            "reviewed_by",
            "reviewed_at",
            "reviewed_label",
            "deferred_until"
          ]
        }
      }
    },
    {
      "Sid": "GetAudioObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::conocetuave-py-uploads/uploads/*"
    },
    {
      "Sid": "DenyAllWrites",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteItem",
        "dynamodb:PutItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DeleteTable",
        "dynamodb:UpdateTable",
        "dynamodb:CreateTable",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:PutObjectTagging",
        "s3:DeleteBucket",
        "s3:PutBucketLifecycleConfiguration",
        "iam:*"
      ],
      "Resource": "*"
    }
  ]
}
