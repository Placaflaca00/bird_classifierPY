# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Loaded automatically by Pydantic Settings (see src/config.py).

# ---------------------------------------------------------------------------
# Weights & Biases
# ---------------------------------------------------------------------------
# Generate at https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=bird-classifier-py
WANDB_ENTITY=

# ---------------------------------------------------------------------------
# Hugging Face
# ---------------------------------------------------------------------------
# Token used to push the Gradio Space and pull private datasets.
HF_TOKEN=
HF_USERNAME=
HF_SPACE_NAME=bird-classifier-py

# ---------------------------------------------------------------------------
# AWS (Lambda + S3 + DynamoDB + ECR + API Gateway)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Buckets / tables
S3_BUCKET_MODELS=
S3_BUCKET_FLAGGED_AUDIO=
DYNAMODB_TABLE_FLAGS=

# ECR + Lambda
ECR_REPOSITORY=bird-classifier-py
LAMBDA_FUNCTION_NAME=bird-classifier-py-inference

# API Gateway endpoint that the Gradio frontend calls.
API_GATEWAY_URL=

# ---------------------------------------------------------------------------
# Xeno-canto
# ---------------------------------------------------------------------------
# Optional API key (most queries work anonymously).
XENOCANTO_API_KEY=

# ---------------------------------------------------------------------------
# Local paths (override defaults from src/config.py if needed)
# ---------------------------------------------------------------------------
DATA_DIR=./data
RAW_AUDIO_DIR=./data/raw
PROCESSED_DIR=./data/processed
TEST_SETS_DIR=./data/test_sets
MODELS_DIR=./models
